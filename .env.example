# Copy to .env (gitignored); the Makefile exports every key to its recipes and to `make start`.
# Room server (server/): listen port; a non-empty SERVER_PASSWORD is then required on every /v1 request.
PORT=8787
SERVER_PASSWORD=
# Browser e2e against a deployment (E2E_BASE_URL set): 1 runs every spec instead of only the @remote smoke tests.
E2E_REMOTE_ALL=
