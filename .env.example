# Copy to .env (gitignored); the Makefile exports every key to its recipes and to `make start`.
# Room server (server/): listen port; a non-empty SERVER_PASSWORD is then required on every /v1 request.
PORT=8787
SERVER_PASSWORD=
# Browser e2e against a deployment (E2E_BASE_URL set): 1 runs every spec instead of only the @remote smoke tests.
E2E_REMOTE_ALL=
# E2E suites (e2e/*.test.mjs, e2e/browser/*): the values below are the code's defaults for a local run.
# E2E_BASE_URL: a deployment to test instead of the spawned local Express server (empty = local).
E2E_BASE_URL=
# The target's server password. Locally the spawned server gets this one; against a deployment set its password
# (empty = an open server).
E2E_SERVER_PASSWORD=e2e-sërver-pässword
# Local ports of the docs site and the spawned signaling server.
E2E_DOCS_PORT=47173
E2E_SIGNAL_PORT=47787
# "Protection Bypass for Automation" secret of a protected Vercel deployment (empty = none); never commit a real one.
E2E_VERCEL_BYPASS=
